# =============================================
# Legal AI System - Environment Variables
# =============================================

# --- Application ---
APP_NAME=Legal AI System
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=your-super-secret-key-change-in-production

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/legal_ai_db
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/legal_ai_db

# --- JWT ---
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# --- File Upload ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=.pdf,.docx,.jpg,.jpeg,.png

# --- OpenAI ---
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# --- Google Vision OCR (Future) ---
GOOGLE_VISION_API_KEY=

# --- Razorpay ---
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# --- Email / SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Legal AI System
SMTP_FROM_EMAIL=noreply@legalai.com

# --- Redis (Celery) ---
REDIS_URL=redis://localhost:6379/0

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
